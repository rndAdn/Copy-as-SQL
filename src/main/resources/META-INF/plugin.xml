<idea-plugin>
    <id>fr.radequin.Copy-as-SQL</id>
    <name>Copy as Sql</name>
    <vendor email="adequin.renaud@gmail.com">Adequin Renaud</vendor>

    <description>This plugin copy SQL result as IN, WHERE, INSERT, UPDATE, or DELETE clauses and put it in the clipboard</description>

    <change-notes><![CDATA[
    <ul>
        <li>1.0.8 - Support IntelliJ IDEA and DataGrip through 2026.2. Match all selected old values in UPDATE and prompt for the new SQL value of the last column. Fix NULL predicates and cancelled dialogs. Add copy notifications and user-friendly errors.</li>
        <li>1.0.7 - Add support for UPDATE and DELETE clauses.</li>
        <li>1.0.6 - Add support for FLOAT, DOUBLE, BOOLEAN, DATE, TIME. Make table name configurable for INSERT clause. Add comprehensive documentation.</li>
        <li>1.0.5 - Fix Compatibility with 2022.2</li>
        <li>1.0.4 - Remove deprecated API usages</li>
        <li>1.0.3 - Add support for DECIMAL, SMALLINT, TIMESTAMP, CHARACTER. Other types are computed as VARCHAR.</li>
        <li>1.0.0 - Only INTEGER, VARCHAR are currently supported.</li>
    </ul>

    ]]>

    </change-notes>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>
    <depends optional="true" config-file="copy-as-sql-grid.xml">intellij.grid.core.plugin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <notificationGroup id="Copy as SQL" displayType="BALLOON" />
    </extensions>
    <actions>
        <!-- Add your actions here -->

        <action
                id="CopyAsInClause.Search.Console"
                class="fr.radequin.copyassql.CopyAsSqlInClause"
                text="Copy as SQL IN Clause"
                description="Squirrel">
            <add-to-group group-id="Console.TableResult.PopupGroup" anchor="last"/>
        </action>
        <action
                id="CopyAsWhereClause.Search.Console"
                class="fr.radequin.copyassql.CopyAsSqlWhereClause"
                text="Copy as SQL WHERE Clause"
                description="Squirrel">
            <add-to-group group-id="Console.TableResult.PopupGroup" anchor="last"/>
        </action>
        <action
                id="CopyAsInsertClause.Search.Console"
                class="fr.radequin.copyassql.CopyAsSqlInsertClause"
                text="Copy as SQL INSERT Clause"
                description="Squirrel">
            <add-to-group group-id="Console.TableResult.PopupGroup" anchor="last"/>
        </action>
        <action
                id="CopyAsUpdateClause.Search.Console"
                class="fr.radequin.copyassql.CopyAsSqlUpdateClause"
                text="Copy as SQL UPDATE Clause"
                description="Squirrel">
            <add-to-group group-id="Console.TableResult.PopupGroup" anchor="last"/>
        </action>
        <action
                id="CopyAsDeleteClause.Search.Console"
                class="fr.radequin.copyassql.CopyAsSqlDeleteClause"
                text="Copy as SQL DELETE Clause"
                description="Squirrel">
            <add-to-group group-id="Console.TableResult.PopupGroup" anchor="last"/>
        </action>

    </actions>
</idea-plugin>
